# 이 파일을 복사해 .env 를 만들고 값을 채운다. (.env 는 커밋되지 않는다)
# cp .env.example .env

# API 서버 주소
VITE_API_BASE_URL=https://api.orte.app/v1

# 백엔드 완성 전에는 true. 각 기능의 *Mock.js 데이터를 사용한다.
VITE_USE_MOCK_API=true

# 구글 로그인
VITE_GOOGLE_CLIENT_ID=

# 구글 지도 (MAP_ID 는 선택, 없으면 데모 ID 사용)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
